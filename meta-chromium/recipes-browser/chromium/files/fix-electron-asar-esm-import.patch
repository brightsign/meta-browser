From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caner Altinbasak <cal@brightsign.biz>
Date: Tue, 29 Jul 2025 16:15:00 +0100
Subject: [PATCH] fix: Use dynamic import() for ESM @electron/asar module

The @electron/asar package is now an ESM module ("type": "module")
but gn-asar.js uses require() to load it. Node.js 22 does not
support require() of ESM modules by default. Convert to use
dynamic import() instead.

Upstream-Status: Inappropriate [OE-specific]
---
 electron/script/gn-asar.js | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

--- a/electron/script/gn-asar.js	2026-04-27 16:16:50.008169629 +0100
+++ b/electron/script/gn-asar.js	2026-04-27 16:16:50.012169592 +0100
@@ -1,5 +1,3 @@
-const asar = require('@electron/asar');
-
 const assert = require('node:assert');
 const fs = require('node:fs');
 const os = require('node:os');
@@ -50,15 +48,17 @@
   fs.promises.rm(tmpPath, { force: true, recursive: true })
     .then(() => process.exit(1))
     .catch(() => process.exit(1));
-  return;
 }
 
-// Create the ASAR archive
-asar.createPackageWithOptions(tmpPath, out[0], {})
-  .catch(err => {
-    const exit = () => {
-      console.error('Unexpected error while generating ASAR', err);
-      process.exit(1);
-    };
-    fs.promises.rm(tmpPath, { force: true, recursive: true }).then(exit).catch(exit);
-  }).then(() => fs.promises.rm(tmpPath, { force: true, recursive: true }));
+// Use dynamic import() for ESM @electron/asar module
+import('@electron/asar').then(asarModule => {
+  const asar = asarModule.default || asarModule;
+  asar.createPackageWithOptions(tmpPath, out[0], {})
+    .catch(err => {
+      const exit = () => {
+        console.error('Unexpected error while generating ASAR', err);
+        process.exit(1);
+      };
+      fs.promises.rm(tmpPath, { force: true, recursive: true }).then(exit).catch(exit);
+    }).then(() => fs.promises.rm(tmpPath, { force: true, recursive: true }));
+});
-- 
