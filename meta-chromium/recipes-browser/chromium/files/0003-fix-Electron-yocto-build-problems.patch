+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(IS_OZONE_X11)
   if (x11_util::IsX11()) {
     const std::string color = use_dark_theme ? "dark" : "light";
     auto* connection = x11::Connection::Get();
@@ -576,7 +578,7 @@
 
   NotifyWindowShow();
 
-#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(IS_OZONE_X11)
   if (global_menu_bar_)
     global_menu_bar_->OnWindowMapped();
 
@@ -592,7 +594,7 @@
 
   NotifyWindowShow();
 
-#if BUILDFLAG(IS_LINUX)
