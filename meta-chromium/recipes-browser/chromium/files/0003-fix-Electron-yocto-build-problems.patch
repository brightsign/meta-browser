From e1d41130d98f66b0a48e07bf8d76737caee3d65b Mon Sep 17 00:00:00 2001
From: Caner Altinbasak <cal@brightsign.biz>
Date: Tue, 29 Jul 2025 17:21:47 +0100
Subject: [PATCH] fix: Electron yocto build problems

Guard X11-specific code behind IS_OZONE_X11 checks so that
wayland-only builds compile without X11 headers and libraries.
Also add missing sys/prctl.h include for zygote.

Upstream-Status: Inappropriate [OE-specific]
---
 content/zygote/zygote_linux.cc                        |  1 +
 electron/shell/browser/native_window_views.cc         | 24 ++++++++-------
 electron/shell/browser/native_window_views.h          |  4 +--
 electron/shell/browser/osr/osr_host_display_client.cc |  2 +-
 electron/shell/browser/osr/osr_host_display_client.h  |  2 +-
 electron/shell/browser/ui/gtk/menu_util.cc            |  7 +++++
 6 files changed, 25 insertions(+), 15 deletions(-)

--- a/content/zygote/zygote_linux.cc	2026-04-27 15:33:56.152351104 +0100
+++ b/content/zygote/zygote_linux.cc	2026-04-27 15:34:02.176290643 +0100
@@ -13,6 +13,7 @@
 #include <sys/socket.h>
 #include <sys/types.h>
 #include <sys/wait.h>
+#include <sys/prctl.h>
 #include <grp.h>
 
 #include <tuple>
--- a/electron/shell/browser/native_window_views.cc	2026-04-27 15:33:56.156351064 +0100
+++ b/electron/shell/browser/native_window_views.cc	2026-04-27 15:34:23.256079464 +0100
@@ -327,6 +327,7 @@
   if (parent)
     SetParentWindow(parent);
 
+#if BUILDFLAG(IS_OZONE_X11)
   if (x11_util::IsX11()) {
     // Before the window is mapped the SetWMSpecState can not work, so we have
     // to manually set the _NET_WM_STATE.
@@ -359,6 +360,7 @@
                     window_type);
   }
 #endif
+#endif
 
 #if BUILDFLAG(IS_WIN)
   if (!has_frame()) {
@@ -515,7 +517,7 @@
 }
 
