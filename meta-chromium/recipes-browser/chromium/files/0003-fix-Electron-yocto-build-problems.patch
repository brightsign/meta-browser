   if (global_menu_bar_ && menu_model == nullptr) {
     global_menu_bar_.reset();
@@ -1459,7 +1461,7 @@
 void NativeWindowViews::SetParentWindow(NativeWindow* parent) {
   NativeWindow::SetParentWindow(parent);
 
-#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(IS_OZONE_X11)
   if (x11_util::IsX11()) {
     auto* connection = x11::Connection::Get();
     connection->SetProperty(
--- a/electron/shell/browser/native_window_views.h	2026-04-27 15:33:56.160351023 +0100
+++ b/electron/shell/browser/native_window_views.h	2026-04-27 15:34:47.371838599 +0100
@@ -32,7 +32,7 @@
 
 namespace electron {
 
-#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(IS_OZONE_X11)
 class ClientFrameViewLinux;
 class GlobalMenuBarX11;
 class LinuxFrameLayout;
@@ -278,7 +278,7 @@
   // events from resizing the window.
   extensions::SizeConstraints old_size_constraints_;
 
-#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(IS_OZONE_X11)
   std::unique_ptr<GlobalMenuBarX11> global_menu_bar_;
 #endif
 
--- a/electron/shell/browser/osr/osr_host_display_client.cc	2026-04-27 15:33:56.164350984 +0100
+++ b/electron/shell/browser/osr/osr_host_display_client.cc	2026-04-27 15:34:47.383838481 +0100
@@ -102,7 +102,7 @@
   layered_window_updater_->SetActive(active_);
 }
 
-#if BUILDFLAG(IS_LINUX) && !BUILDFLAG(IS_CHROMEOS)
